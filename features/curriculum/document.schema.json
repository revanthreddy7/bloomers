{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "curriculumId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "academicLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "learningObjectives": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      }
    },
    "units": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "position": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "learningObjectives": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            }
          },
          "topics": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "\\S"
                },
                "position": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "teachingObjectives": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "\\S"
                  }
                },
                "expectedOutcomes": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "\\S"
                  }
                },
                "content": {
                  "type": "object",
                  "properties": {
                    "learningObjectives": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "pattern": "\\S"
                      }
                    },
                    "keyConcepts": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "pattern": "\\S"
                      }
                    },
                    "explanations": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "pattern": "\\S"
                      }
                    },
                    "workedExamples": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "problem": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000,
                            "pattern": "\\S"
                          },
                          "steps": {
                            "maxItems": 100,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2000,
                              "pattern": "\\S"
                            }
                          }
                        },
                        "required": ["problem", "steps"],
                        "additionalProperties": false
                      }
                    },
                    "commonMistakes": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "pattern": "\\S"
                      }
                    },
                    "practiceQuestions": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "skillId": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "prompt": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000,
                            "pattern": "\\S"
                          }
                        },
                        "required": ["skillId", "prompt"],
                        "additionalProperties": false
                      }
                    },
                    "assessmentObjectives": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "pattern": "\\S"
                      }
                    },
                    "whiteboardPlans": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "\\S"
                          },
                          "steps": {
                            "maxItems": 100,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2000,
                              "pattern": "\\S"
                            }
                          }
                        },
                        "required": ["title", "steps"],
                        "additionalProperties": false
                      }
                    },
                    "resourceReferences": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200,
                            "pattern": "\\S"
                          },
                          "reference": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000,
                            "pattern": "\\S"
                          }
                        },
                        "required": ["label", "reference"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "learningObjectives",
                    "keyConcepts",
                    "explanations",
                    "workedExamples",
                    "commonMistakes",
                    "practiceQuestions",
                    "assessmentObjectives",
                    "whiteboardPlans",
                    "resourceReferences"
                  ],
                  "additionalProperties": false
                },
                "skills": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "\\S"
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000,
                        "pattern": "\\S"
                      },
                      "position": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "difficulty": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5
                      },
                      "estimatedMinutes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 600
                      },
                      "masteryThreshold": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1
                      },
                      "assessment": {
                        "type": "object",
                        "properties": {
                          "independentCorrectRequired": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 20
                          },
                          "allowHintsForMastery": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "independentCorrectRequired",
                          "allowHintsForMastery"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "id",
                      "code",
                      "name",
                      "description",
                      "position",
                      "difficulty",
                      "estimatedMinutes",
                      "masteryThreshold",
                      "assessment"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "name",
                "description",
                "position",
                "teachingObjectives",
                "expectedOutcomes",
                "content",
                "skills"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "position",
          "learningObjectives",
          "topics"
        ],
        "additionalProperties": false
      }
    },
    "prerequisites": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skillId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "prerequisiteId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "required": ["skillId", "prerequisiteId"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "curriculumId",
    "name",
    "description",
    "academicLevel",
    "subject",
    "learningObjectives",
    "units",
    "prerequisites"
  ],
  "additionalProperties": false
}
