{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "stroke"
        },
        "payload": {
          "type": "object",
          "properties": {
            "points": {
              "minItems": 2,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": ["x", "y"],
                "additionalProperties": false
              }
            },
            "color": {
              "type": "string",
              "enum": ["#263b36", "#246bce", "#c34e35"]
            },
            "width": {
              "type": "number",
              "minimum": 1,
              "maximum": 12
            }
          },
          "required": ["points", "color", "width"],
          "additionalProperties": false
        }
      },
      "required": ["kind", "payload"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "erase"
        },
        "payload": {
          "type": "object",
          "properties": {
            "targetId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": ["targetId"],
          "additionalProperties": false
        }
      },
      "required": ["kind", "payload"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "undo"
        },
        "payload": {
          "type": "object",
          "properties": {
            "targetId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": ["targetId"],
          "additionalProperties": false
        }
      },
      "required": ["kind", "payload"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "redo"
        },
        "payload": {
          "type": "object",
          "properties": {
            "targetId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": ["targetId"],
          "additionalProperties": false
        }
      },
      "required": ["kind", "payload"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "clear_board"
        },
        "payload": {
          "type": "object",
          "properties": {
            "confirmed": {
              "type": "boolean",
              "const": true
            }
          },
          "required": ["confirmed"],
          "additionalProperties": false
        }
      },
      "required": ["kind", "payload"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "connection_interrupted"
        },
        "payload": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": ["kind", "payload"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "connection_recovered"
        },
        "payload": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": ["kind", "payload"],
      "additionalProperties": false
    }
  ]
}
