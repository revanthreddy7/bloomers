{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(UTC|[A-Za-z_+-]+\\/[A-Za-z0-9_+\\/-]+)$"
    },
    "lessonDurationMinutes": {
      "type": "integer",
      "minimum": 20,
      "maximum": 90
    },
    "weeklyFrequency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "slots": {
      "minItems": 1,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "weekday": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        },
        "required": ["weekday", "time"],
        "additionalProperties": false
      }
    },
    "earliestDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "schemaVersion",
    "timezone",
    "lessonDurationMinutes",
    "weeklyFrequency",
    "slots",
    "earliestDate"
  ],
  "additionalProperties": false
}
