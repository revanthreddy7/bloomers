    {
      "id": "00000000-0000-0000-0000-000000000003",
      "name": "Algebra",
      "description": "Equality and inverse operations.",
      "position": 1,
      "learningObjectives": ["Preserve equality while isolating an unknown."],
      "topics": [
        {
          "id": "00000000-0000-0000-0000-000000000004",
          "name": "Linear Equations",
          "description": "From arithmetic foundations to two-step equations.",
          "position": 1,
          "teachingObjectives": ["Model inverse operations using a balance."],
          "expectedOutcomes": [
            "Independently solve and check two-step equations."
          ],
          "content": {
            "learningObjectives": [
              "Solve and check one-step and two-step linear equations."
            ],
            "keyConcepts": [
              "Equality is preserved when the same operation is applied to both sides.",
              "Signed-number and fraction fluency support equation solving."
            ],
            "explanations": [
              "An equation is a balance. To isolate the unknown, undo operations in reverse order, applying each inverse operation to both sides."
            ],
            "workedExamples": [
              {
                "problem": "Solve 2x + 3 = 11.",
                "steps": [
                  "Subtract 3 from both sides: 2x = 8.",
                  "Divide both sides by 2: x = 4.",
                  "Substitute to check: 2(4) + 3 = 11."
                ]
              }
            ],
            "commonMistakes": [
              "Changing one side only breaks equality.",
              "Dividing before undoing addition can omit a term."
            ],
            "practiceQuestions": [
              {
                "skillId": "00000000-0000-0000-0000-000000000014",
                "prompt": "Solve y - 4 = 9 and explain your check."
              },
              {
                "skillId": "00000000-0000-0000-0000-000000000015",
                "prompt": "Solve 3y + 2 = 17 and explain each operation."
              }
            ],
            "assessmentObjectives": [
              "Demonstrate independent solving and substitution checks without hints."
            ],
            "whiteboardPlans": [
              {
                "title": "Balance and inverse operations",
                "steps": [
                  "Draw two balanced sides labeled 2x + 3 and 11.",
                  "Strike out 3 on both sides and rewrite 2x = 8.",
                  "Divide both sides into two equal groups and display x = 4.",
                  "Substitute the solution and compare both sides."
                ]
              }
            ],
            "resourceReferences": [
              {
                "label": "Prototype teaching notes",
                "reference": "internal:grade-8/linear-equations"
              }
            ]
