NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
APP_ORIGIN=http://localhost:3000
# Maya always runs a simulation. These server-only settings cannot activate live AI.
MAYA_PROVIDER=mock
MAYA_REALTIME_MODEL=gpt-realtime-2.1
MAYA_PLANNING_MODEL=gpt-6-astra
MAYA_MAX_DURATION_SECONDS=300
MAYA_BUDGET_CENTS=25
MAYA_TIMEOUT_MS=10000
# OPENAI_API_KEY is optional and server-only. Do not set it for the mock demo.
