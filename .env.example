NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
APP_ORIGIN=http://localhost:3000
# Maya always runs a simulation. These server-only settings cannot activate live AI.
MAYA_PROVIDER=mock
MAYA_REALTIME_MODEL=gpt-realtime-2.1
MAYA_PLANNING_MODEL=gpt-6-astra
MAYA_MAX_DURATION_SECONDS=300
MAYA_BUDGET_CENTS=25
MAYA_TIMEOUT_MS=10000

# Separate adult-only local developer console. Do not enable before founder approval.
# Operator-authored UUID allowlist is independent of parent/ADMIN roles.
MAYA_DEV_ORIGIN=http://localhost:3000
MAYA_DEV_USER_IDS=
MAYA_DEV_ENABLED=0
MAYA_DEV_MODEL=gpt-realtime-2.1
# Leave empty until the approved one-session manifest is configured locally.
# See docs/MAYA_DEVELOPMENT.md for the exact schema and cost-risk limitations.
MAYA_DEV_APPROVAL=
# Optional operator-prepared incident to display for authenticated recovery.
MAYA_DEV_RECOVERY_SESSION_ID=
# Optional local-only metadata timing diagnostics; no identifiers or request bodies.
ENROLLMENT_TRACE=0
# OPENAI_API_KEY is optional and server-only. Do not set it for the mock demo.
